{
  "schemaVersion": 1,
  "id": "enderscape",
  "version": "${version}",
  "name": "Enderscape",
  "description": "Total overhaul of The End with new generation, biomes, mobs, and other features.",
  "authors": [
    "lunarbunten",
    "hivye",
    "Konci",
    "Ninni",
    "Orcinus"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/enderscape",
    "sources": "https://github.com/Penumbra-MC/Enderscape",
    "issues": "https://github.com/Penumbra-MC/Enderscape/issues"
  },
  "custom": {
    "launchpad:compatible": true,
    "launchpad:overrides": {
      "depends": {
        "minecraft": "~26.2-",
        "fabricloader": ">=0.19.3",
        "fabric_api": ">=0.161.0+26.2+4.0.1",
        "launchpad": ">=1.10.1",
        "lithostitched": ">=1.7.13",
        "trimpatcher": ">=2.1-mc26.2-neoforge",
        "yet_another_config_lib_v3": ">=3.9.5"
      },
      "entrypoints": {
        "main": [
          "net.penumbra.enderscape.Enderscape"
        ],
        "client": [
          "net.penumbra.enderscape.EnderscapeClient",
          "net.penumbra.enderscape.neoforge.client.EnderscapeNeoForgeClient"
        ],
        "fabric-datagen": [
          "net.penumbra.enderscape.datagen.EnderscapeDataGenerator"
        ],
        "modmenu": [
          "net.penumbra.enderscape.gui.screens.config.EnderscapeModMenu"
        ],
        "jei_mod_plugin": [
          "net.penumbra.enderscape.plugins.jei.EnderscapeJEI"
        ],
        "rrv_client": [
          "net.penumbra.enderscape.plugins.rrv.EnderscapeRRV"
        ]
      },
      "mixins": [
        "enderscape.mixins.json",
        {
          "config": "enderscape.client.mixins.json",
          "environment": "client"
        },
        "enderscape.neoforge.mixins.json"
      ]
    },
    "modmenu": {
      "links": {
        "enderscape.external_link.credits": "https://github.com/Penumbra-MC/Enderscape/wiki/credits",
        "enderscape.external_link.discord": "https://discord.gg/bksj9aqqgb",
        "enderscape.external_link.wiki": "https://github.com/Penumbra-MC/Enderscape/wiki"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/enderscape/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
        "net.penumbra.enderscape.Enderscape"
    ],
    "client": [
        "net.penumbra.enderscape.EnderscapeClient"
    ],
    "fabric-datagen": [
        "net.penumbra.enderscape.datagen.EnderscapeDataGenerator"
    ],
    "modmenu": [
      "net.penumbra.enderscape.gui.screens.config.EnderscapeModMenu"
    ],
    "jei_mod_plugin": [
      "net.penumbra.enderscape.plugins.jei.EnderscapeJEI"
    ],
    "rrv_client": [
      "net.penumbra.enderscape.plugins.rrv.EnderscapeRRV"
    ]
  },
  "mixins": [
    "enderscape.mixins.json",
    {
      "config": "enderscape.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "~26.2-",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.154.2",
    "lithostitched": ">=1.7.13",
    "trimpatcher": ">=1.0-mc26.2",
    "yet_another_config_lib_v3": ">=3.9.5"
  },
  "accessWidener": "enderscape.accesswidener"
}
